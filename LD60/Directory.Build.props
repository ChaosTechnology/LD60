<?xml version="1.0" encoding="utf-8"?>
<Project>

  <Import Project="$(SolutionDir)submodules/ChaosPresets.Targets/Properties/SetOs.targets"/>

  <PropertyGroup>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)'=='Linux'">
    <TargetFrameworks>net8.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)'=='Windows'">
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <UseWinForms>true</UseWinForms>
  </PropertyGroup>

  <Import Project="$(SolutionDir)submodules/ChaosPresets.Targets/Paths/Output/Common.targets" />

</Project>
